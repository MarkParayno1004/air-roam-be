# Host port for the Docker Postgres; must match the port in DATABASE_URL
DB_PORT=5434
DATABASE_URL=postgres://air_roam:air_roam@localhost:5434/air_roam
REDIS_URL=redis://localhost:6379/0
DJANGO_SECRET_KEY=replace-with-a-random-string-of-at-least-50-characters
DEBUG=true
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174
CSRF_COOKIE_DOMAIN=
WEB_STORE_URL=http://localhost:5173
APP_DEEP_LINK=airroam://payment-result
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Only methods enabled on the PayMongo account
PAYMONGO_METHODS=gcash,paymaya,qrph,card
WEB_REBUILD_HOOK_URL=
ADMIN_ENABLED=true
ADMIN_URL=dev-admin/
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
NUM_PROXIES=0
